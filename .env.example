# Robinhood Chain
ROBINHOOD_RPC_URL=

# Deployment wallet (5D broadcast only — never commit the private key)
DEPLOYER_ADDRESS=
DEPLOYER_PRIVATE_KEY=

# Immutable authorities (set explicitly — no silent defaults)
REGISTRY_AUTHORITY=
ORACLE_AUTHORITY=
VERIFICATION_AUTHORITY=

# Immutable fee recipients (must be ETH-receivable before mainnet)
LAUNCH_FEE_RECIPIENT=
BUYBACK_VAULT=
OPERATIONS=

# Oracle / quote rehearsal configuration (required by DeployScoop.s.sol)
# SCOOP_ETH_MAX_AGE: seconds (e.g. 86400). Production equity maxAge is a separate decision.
SCOOP_ETH_MAX_AGE=
# true/false — AAPL is REHEARSAL ONLY and must not silently become production policy
SCOOP_INCLUDE_AAPL_REHEARSAL=
# Required only when SCOOP_INCLUDE_AAPL_REHEARSAL=true
SCOOP_AAPL_MAX_AGE=
