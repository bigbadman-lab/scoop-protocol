# Robinhood Chain
ROBINHOOD_RPC_URL=

# ---------------------------------------------------------------------------
# Production role public addresses (safe to document; never commit .env)
# ---------------------------------------------------------------------------
# Scoop Deploy 1 — Phase A global deployment only
DEPLOYER_ADDRESS=
# Scoop Auth 1 — Phase B quote/oracle configuration (REGISTRY == ORACLE for MVP)
REGISTRY_AUTHORITY=
ORACLE_AUTHORITY=
# Scoop Verify 1 — X identity claim signatures only (does not deploy/configure)
VERIFICATION_AUTHORITY=
# Scoop Treasury 1 / Buyback 1 / Operations 1 — immutable fee recipients (EOAs preferred)
LAUNCH_FEE_RECIPIENT=
BUYBACK_VAULT=
OPERATIONS=

# ---------------------------------------------------------------------------
# Private keys — 5D broadcast ONLY. Never commit. Never echo. Never log.
# ---------------------------------------------------------------------------
DEPLOYER_PRIVATE_KEY=
AUTHORITY_PRIVATE_KEY=

# Explicit broadcast gate (default false / unset). Do NOT set true in 5C.1.
SCOOP_BROADCAST=false

# ---------------------------------------------------------------------------
# Phase B oracle / quote configuration
# ---------------------------------------------------------------------------
# Proposed production ETH maxAge (seconds). Equity maxAge is a separate decision.
SCOOP_ETH_MAX_AGE=86400

# ---------------------------------------------------------------------------
# Phase A → Phase B handoff addresses (fill after DeployScoopGlobals)
# ---------------------------------------------------------------------------
SCOOP_CREATOR_REGISTRY=
SCOOP_TOKEN_DEPLOYER=
SCOOP_LAUNCH_DEPLOYER=
SCOOP_QUOTE_REGISTRY=
SCOOP_PRICE_ORACLE=
SCOOP_FACTORY_DEPLOYER=
SCOOP_CREATOR_REWARDS=
SCOOP_FACTORY=

# ---------------------------------------------------------------------------
# Legacy single-signer rehearsal only (DeployScoop.s.sol — NOT production 5D)
# ---------------------------------------------------------------------------
# true/false — AAPL is REHEARSAL ONLY and must not silently become production policy
SCOOP_INCLUDE_AAPL_REHEARSAL=
# Required only when SCOOP_INCLUDE_AAPL_REHEARSAL=true
SCOOP_AAPL_MAX_AGE=
